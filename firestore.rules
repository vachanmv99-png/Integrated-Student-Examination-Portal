rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.role == 'admin'; }
    match /students/{studentId} { allow read: if signedIn() && (request.auth.uid == studentId || admin()); allow update: if request.auth.uid == studentId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone','email','updatedAt']); allow create, delete: if false; }
    match /subjects/{id} { allow read: if signedIn(); allow write: if admin(); }
    match /applications/{id} { allow read: if signedIn() && (resource.data.studentId == request.auth.uid || admin()); allow write: if false; }
    match /payments/{id} { allow read: if signedIn() && (resource.data.studentId == request.auth.uid || admin()); allow write: if false; }
  }
}
